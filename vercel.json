{
  "redirects": [
    { "source": "/privacy.html", "destination": "/privacy", "permanent": true },
    { "source": "/support.html", "destination": "/support", "permanent": true },
    { "source": "/terms.html", "destination": "/terms", "permanent": true },
    { "source": "/about.html", "destination": "/about", "permanent": true },
    { "source": "/blog", "destination": "/aonverse/blog", "permanent": false },
    { "source": "/blog/:path*", "destination": "/aonverse/blog/:path*", "permanent": false }
  ],
  "rewrites": [
    { "source": "/about", "destination": "https://wanderwork-backend-server.onrender.com/about" },
    { "source": "/privacy", "destination": "https://wanderwork-backend-server.onrender.com/privacy" },
    { "source": "/terms", "destination": "https://wanderwork-backend-server.onrender.com/terms" },
    { "source": "/support", "destination": "https://wanderwork-backend-server.onrender.com/support" },
    { "source": "/account-deletion", "destination": "https://wanderwork-backend-server.onrender.com/account-deletion" },
    { "source": "/account-deletion/:path*", "destination": "https://wanderwork-backend-server.onrender.com/account-deletion/:path*" },
    { "source": "/sitemap.xml", "destination": "https://wanderwork-backend-server.onrender.com/sitemap.xml" },
    { "source": "/sitemaps/:path*", "destination": "https://wanderwork-backend-server.onrender.com/sitemaps/:path*" },
    { "source": "/feeds/:path*", "destination": "https://wanderwork-backend-server.onrender.com/feeds/:path*" },
    { "source": "/jobs/:path*", "destination": "https://wanderwork-backend-server.onrender.com/jobs/:path*" },
    { "source": "/aonverse/blog/admin", "destination": "/index.html" },
    { "source": "/aonverse/blog/admin/:path*", "destination": "/index.html" },
    { "source": "/aonverse/blog", "destination": "https://wanderwork-backend-server.onrender.com/aonverse/blog" },
    { "source": "/aonverse/blog/:path*", "destination": "https://wanderwork-backend-server.onrender.com/aonverse/blog/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
