{
  "manifest_version": 3,
  "name": "Wanderwork Autofill",
  "version": "1.0.1",
  "description": "Autofill job applications instantly with your Wanderwork profile. Works on Greenhouse, Lever, Ashby, Workday, and more.",
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": [
    "https://boards.greenhouse.io/*",
    "https://job-boards.greenhouse.io/*",
    "https://*.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://jobs.ashbyhq.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://careers.smartrecruiters.com/*",
    "https://apply.workable.com/*",
    "https://jobs.jobvite.com/*",
    "https://wanderwork-backend-server.onrender.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["logo.svg"],
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://*.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://careers.smartrecruiters.com/*",
        "https://apply.workable.com/*",
        "https://jobs.jobvite.com/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Wanderwork Autofill",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://*.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://careers.smartrecruiters.com/*",
        "https://apply.workable.com/*",
        "https://jobs.jobvite.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
