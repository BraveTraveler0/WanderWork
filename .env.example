# Environment variables for Wanderwork (Vite)
# Copy to .env and adjust values locally. .env is gitignored.

# Backend API base URL for JobSeeker endpoints
# Option 1: Hosted server (default, always available)
VITE_API_BASE_URL=https://application-server-cwqu.onrender.com

# Option 2: Local AON server (if running `cd /server && npm run dev` on port 8000)
# VITE_API_BASE_URL=http://localhost:8000

# Optional: local override used by AON examples; will be used if VITE_API_BASE_URL is unset
# VITE_LOCAL_APP_SERVER_URL=http://localhost:8000

# Feature flags
VITE_ENABLE_ANALYTICS=false
