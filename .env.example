# Environment variables for Wanderwork (Vite)
# Copy to .env and adjust values locally. .env is gitignored.

# Backend API base URL for JobSeeker endpoints
# Option 1: WanderWork hosted backend (default, always available)
VITE_API_BASE_URL=https://wanderwork-backend-server.onrender.com

# Option 2: Local AON server (if running `cd /server && npm run dev` on port 8000)
# VITE_API_BASE_URL=http://localhost:8000

# Optional: local override used by AON examples; will be used if VITE_API_BASE_URL is unset
# VITE_LOCAL_APP_SERVER_URL=http://localhost:8000

# Feature flags
VITE_ENABLE_ANALYTICS=false

# Google OAuth (required for "Continue with Google" button)
# 1. Go to console.cloud.google.com > APIs & Services > Credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Add http://localhost:5173 (and your prod domain) as Authorized JavaScript origins
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Lemon Squeezy checkout URLs (from your LS product dashboard)
VITE_LS_TOKENS_URL=
VITE_LS_PRO_URL=
VITE_LS_PREMIUM_URL=

# Paddle checkout URLs (from your Paddle product dashboard)
VITE_PADDLE_TOKENS_URL=
VITE_PADDLE_PRO_URL=
VITE_PADDLE_PREMIUM_URL=
